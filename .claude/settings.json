{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/tarx-session-start.sh",
            "timeout": 10,
            "statusMessage": "Loading TARX context..."
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/tarx-session-start.sh",
            "timeout": 10,
            "statusMessage": "Loading TARX context..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/tarx-stop.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ]
  }
}
