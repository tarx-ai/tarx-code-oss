    "chat.requestBubbleHoverBackground": "#379CD746"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6b7280",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "storage.modifier",
        "storage.type"
      ],
      "settings": {
        "foreground": "#c084fc"
      }
    },
    {
      "name": "Control flow keywords",
      "scope": [
        "keyword.control"
      ],
      "settings": {
        "foreground": "#c084fc",
        "fontStyle": "bold"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#34d399"
      }
    },
    {
      "name": "String escape sequences",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#10b981"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#f59e0b"
      }
    },
    {
      "name": "Built-in constant",
      "scope": [
        "constant.language",
        "support.constant",
        "variable.language"
      ],
      "settings": {
        "foreground": "#f472b6"
      }
    },
    {
      "name": "User-defined constant",
      "scope": [
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#f472b6"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#60a5fa"
      }
    },
    {
      "name": "Function call",
      "scope": [
        "variable.function",
        "support.function.magic"
      ],
      "settings": {
        "foreground": "#60a5fa"
      }
    },
    {
      "name": "Type/Class",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#38bdf8"
      }
    },
    {
      "name": "Interface",
      "scope": [
        "entity.name.interface"
      ],
      "settings": {
        "foreground": "#38bdf8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#d4d4dc"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#d4d4dc"
      }
    },
    {
      "name": "Object key",
      "scope": [
        "meta.object-literal.key",
        "string.unquoted"
      ],
      "settings": {
        "foreground": "#38bdf8"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#c084fc"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#9ca3af"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#c084fc"
      }
    },
    {
      "name": "Tag attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#60a5fa"
      }
    },
    {
      "name": "Decorator/Annotation",
      "scope": [
        "meta.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#f59e0b"
      }
    },
    {
      "name": "Regular expression",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#34d399"
      }
    },
    {
      "name": "Markup heading",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#60a5fa",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#d4d4dc",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#d4d4dc",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup link",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#40B6FB"
      }
    },
    {
      "name": "Markup code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#34d399"
      }
    },
    {
      "name": "Markup quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#6b7280",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup list",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#c084fc"
      }
    },
    {
      "name": "JSON key",
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#38bdf8"
      }
    },
    {
      "name": "CSS selector",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#c084fc"
      }
    },
    {
      "name": "CSS property",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#38bdf8"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FF326D"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#eab308"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#38bdf8",
    "type": "#38bdf8",
    "class": "#38bdf8",
    "interface": {
      "foreground": "#38bdf8",
      "italic": true
    },
    "enum": "#38bdf8",
    "enumMember": "#f472b6",
    "function": "#60a5fa",
    "method": "#60a5fa",
    "variable": "#d4d4dc",
    "parameter": "#d4d4dc",
    "property": "#d4d4dc",
    "constant": "#f472b6",
    "keyword": "#c084fc",
    "string": "#34d399",
    "number": "#f59e0b",
    "regexp": "#34d399",
    "operator": "#c084fc",
    "comment": {
      "foreground": "#6b7280",
      "italic": true
    },
    "decorator": "#f59e0b",
    "macro": "#f59e0b"
  }
}
