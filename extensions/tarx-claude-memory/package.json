{
  "name": "tarx-claude-memory",
  "displayName": "TARX Memory",
  "version": "1.0.0",
  "engines": {
    "node": ">=18.0.0",
    "vscode": "^1.85.0"
  },
  "private": true,
  "description": "Persistent memory for Claude - stores conversations locally, retrieves context via semantic search",
  "author": "TARX",
  "license": "MIT",
  "main": "dist/server.js",
  "bin": {
    "tarx-claude-memory": "./dist/server.js"
  },
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/tarx-project/tarx-code-oss"
  },
  "keywords": [
    "mcp",
    "claude",
    "memory",
    "tarx",
    "local",
    "privacy"
  ],
  "mcp": {
    "name": "TARX Memory",
    "description": "Local memory extension for Claude - never forget context",
    "icon": "assets/icon.png",
    "tools": [
      "memory_store",
      "memory_search",
      "memory_recall",
      "memory_forget",
      "memory_list",
      "memory_stats",
      "thread_message",
      "memory_create_session",
      "memory_thread_to_session",
      "memory_get_session"
    ]
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsc -w"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "better-sqlite3": "^12.6.2",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}
