{
  "name": "tarx-admin-mcp-server",
  "version": "1.0.0",
  "engines": {
    "node": ">=18.0.0",
    "vscode": "^1.85.0"
  },
  "description": "TARX Admin MCP Server - Dev/Admin tools (not shipped to users)",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "tarx-admin-mcp": "./dist/server.js"
  },
  "scripts": {
    "build": "esbuild src/server.ts --outfile=dist/server.js --format=esm --platform=node --target=node18 --bundle --packages=external",
    "build:tsc": "tsc",
    "dev": "esbuild src/server.ts --outfile=dist/server.js --format=esm --platform=node --target=node18 --bundle --packages=external --watch",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@tarx/shared-db": "file:../tarx-shared",
    "better-sqlite3": "^11.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.0.0",
    "esbuild": "^0.27.3",
    "typescript": "^5.0.0"
  },
  "private": true
}
