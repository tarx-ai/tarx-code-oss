{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "node",
		"jsx": "react-jsx",
		"strict": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"outDir": "../../../out/webview",
		"rootDir": ".",
		"lib": ["ES2020", "DOM", "DOM.Iterable"],
		"sourceMap": true
	},
	"include": ["./**/*.ts", "./**/*.tsx"],
	"exclude": ["node_modules"]
}
